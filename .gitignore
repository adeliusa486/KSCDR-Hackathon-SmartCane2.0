__pycache__/
*.pyc

# Full-system backups (SD card images, Pi config tarballs) live next to the
# repo, not in it. Their sha256 sums are committed under baseline/.
backups/
*.img
*.img.gz
*.img.xz

# D:\smart cane 2.0 is both the git repository and the project's home on disk.
# These folders hold the large local data and environments, never committed:
# datasets/: images + labels of merged_v2, training runs, Hailo build files
# envs/: Python environments, the WSL distro with the Hailo compiler
datasets/
envs/
*.har
.pytest_cache/

# Website build output (web/build.py)
web/_site/

# Private working notes, kept on the laptop only
docs/handoff-prompt.md
docs/smart-cane-prompt.md
docs/phase-prompts/
