[Unit]
# Smart cane - the live dashboard on the internet whenever the cane is on, so
# the website's live page finds it by itself (tools/live_tunnel.sh).
# The dashboard always needs the token. To keep the cane off the internet:
#   systemctl --user disable --now smartcane-live
#
# Install:  cp smartcane-live.service ~/.config/systemd/user/
#           systemctl --user daemon-reload
#           systemctl --user enable --now smartcane-live
Description=Smart cane live dashboard online
After=smartcane.service

[Service]
Type=simple
ExecStart=/bin/bash /home/pi/smartcane/tools/live_tunnel.sh
# No internet yet, or the tunnel dropped: try again. Each start is a new
# address, posted to the relay, so the website follows.
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
